elseif cmd == "ia" then if not S.abuseMode then return end; doIA()
elseif cmd == "havoc" then if not S.abuseMode then return end; doHavoc()
elseif cmd == "aura" then if not S.abuseMode then return end; startAura()
elseif cmd == "noaura" or cmd == "unaura" then if not S.abuseMode then return end; stopAura()
elseif cmd == "aurareach" then if not S.abuseMode then return end; local v = tonumber(arg1); if v then setAuraReach(v) end
elseif cmd == "aurapart" then if not S.abuseMode then return end; if arg1 then setAuraPart(arg1) end
elseif cmd == "rspy" or cmd == "remotespy" then if not S.abuseMode then return end; doRspy()
elseif cmd == "simplespy" then if not S.abuseMode then return end; doSimpleSpy()
elseif cmd == "jerk" then if not S.abuseMode then return end; doJerk()
elseif cmd == "fly" then
if not S.abuseMode then return end
if FlyS.flying then stopFly() else local ok = startFly(); if not ok then notifSet("fly", "Fly FAILED", false) end end
elseif cmd == "unfly" or cmd == "nofly" then if not S.abuseMode then return end; if FlyS.flying then stopFly() end
elseif cmd == "flyspeed" or cmd == "flyws" then if not S.abuseMode then return end; local v = tonumber(arg1); if v and v > 0 then setFlySpeed(v) end
elseif cmd == "safefly" then
if not S.abuseMode then return end
if SafeFlyS.active then stopSafeFly() else local ok = startSafeFly(); if not ok then notifSet("safefly", "SafeFly FAILED", false) end end
elseif cmd == "unsafefly" or cmd == "nosafefly" then if not S.abuseMode then return end; if SafeFlyS.active then stopSafeFly() end
elseif cmd == "safeflyspeed" or cmd == "safefs" then if not S.abuseMode then return end; local v = tonumber(arg1); if v and v > 0 then setSafeFlySpeed(v) end
elseif cmd == "playercount" or cmd == "pcount" or cmd == "toggleplayercount" then
S.showPlayerCount = not S.showPlayerCount
G.playerCountGui.Enabled = S.showPlayerCount
updatePlayerCountColor()
showNotify(S.showPlayerCount and "Player Count: ON" or "Player Count: OFF", S.showPlayerCount and C.SUCCESS or C.SUBTEXT)
elseif cmd == "ignorenpcs" or cmd == "nonpcs" or cmd == "npcsoff" then S.npcEspEnabled = false; clearNpcEsp(); showNotify("NPC ESP: OFF", C.SUBTEXT)
elseif cmd == "unignorenpcs" or cmd == "npcs" or cmd == "npcson" then S.npcEspEnabled = true; showNotify("NPC ESP: ON", C.SUCCESS)
end
end

G.gui.MouseEnter:Connect(function()
S.mouseOverGui = true
if S.hideTimer then task.cancel(S.hideTimer); S.hideTimer = nil end
end)
G.gui.MouseLeave:Connect(function() S.mouseOverGui = false; scheduleHide() end)

local function isMouseOverGui()
if not G.gui.Visible then return false end
local mousePos = M.UserInputService:GetMouseLocation()
local absPos = G.gui.AbsolutePosition
local absSize = G.gui.AbsoluteSize
if mousePos.X >= absPos.X and mousePos.X <= absPos.X + absSize.X and mousePos.Y >= absPos.Y and mousePos.Y <= absPos.Y + absSize.Y then return true end
return false
end
M.UserInputService.InputChanged:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseMovement and G.gui.Visible then S.mouseOverGui = isMouseOverGui() end
end)

local function isAnyTextboxFocused()
return G.cmdBar:IsFocused() or fcSpeedBox:IsFocused() or G.viewBox:IsFocused() or G.espTransBox:IsFocused()
end

local function showGUI()
if S.hideTimer then task.cancel(S.hideTimer); S.hideTimer = nil end
G.gui.Visible = true
end

local function scheduleHide()
if S.hideTimer then task.cancel(S.hideTimer) end
S.hideTimer = task.delay(2, function()
if isMouseOverGui() or isAnyTextboxFocused() or S.prefixWaiting then scheduleHide() return end
G.gui.Visible = false
G.hintBar.Visible = false
clearAC()
clearPreviewHighlight()
S.hideTimer = nil
end)
end

G.cmdBar.Focused:Connect(function() if S.hideTimer then task.cancel(S.hideTimer); S.hideTimer = nil end; showGUI() end)
fcSpeedBox.Focused:Connect(function() if S.hideTimer then task.cancel(S.hideTimer); S.hideTimer = nil end; showGUI() end)
G.viewBox.Focused:Connect(function() if S.hideTimer then task.cancel(S.hideTimer); S.hideTimer = nil end; showGUI() end)
G.espTransBox.Focused:Connect(function() if S.hideTimer then task.cancel(S.hideTimer); S.hideTimer = nil end; showGUI() end)

G.cmdBar.FocusLost:Connect(function(enter)
if enter and G.cmdBar.Text ~= "" then
local raw = G.cmdBar.Text
G.cmdBar.Text = ""
local cmdText = raw
if cmdText:sub(1, #S.prefix) == S.prefix then cmdText = cmdText:sub(#S.prefix + 1) end
execCmd(cmdText)
G.hintBar.Visible = false
clearAC()
clearPreviewHighlight()
end
scheduleHide()
end)
fcSpeedBox.FocusLost:Connect(function() scheduleHide() end)
G.viewBox.FocusLost:Connect(function() scheduleHide() end)
G.espTransBox.FocusLost:Connect(function() scheduleHide() end)

G.cmdBar:GetPropertyChangedSignal("Text"):Connect(function()
if S.prefixWaiting then return end
if G.cmdBar.Text:find("\t") then G.cmdBar.Text = G.cmdBar.Text:gsub("\t", "") end
local textForHint = G.cmdBar.Text
if textForHint:sub(1, #S.prefix) == S.prefix then textForHint = textForHint:sub(#S.prefix + 1) end
updateHint(getHint(textForHint))
local textForAC = G.cmdBar.Text
if textForAC:sub(1, #S.prefix) == S.prefix then textForAC = textForAC:sub(#S.prefix + 1) end
local cmd, query = parseACInput(textForAC)
if cmd then showAC(cmd, query) else clearAC() end
end)

M.UserInputService.InputBegan:Connect(function(input, gp)
if S.prefixWaiting then
if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
local kn = input.KeyCode.Name
local skip = {LeftShift=1,RightShift=1,LeftControl=1,RightControl=1,LeftAlt=1,RightAlt=1,CapsLock=1,Tab=1,Backspace=1,Delete=1,Return=1,Escape=1,LeftSuper=1,RightSuper=1,F1=1,F2=1,F3=1,F4=1,F5=1,F6=1,F7=1,F8=1,F9=1,F10=1,F11=1,F12=1}
if skip[kn] then return end
local sm = {Semicolon=";",Period=".",Comma=",",Slash="/",BackSlash="\\",Quote="'",LeftBracket="[",RightBracket="]",Minus="-",Equals="=",Tilde="`",Space=" "}
S.prefix = sm[kn] or (#kn==1 and kn:lower()) or kn:sub(1,1):lower()
setPrefixWaiting(false)
return
end
if not gp then
local kn = input.KeyCode.Name
local sm = {Semicolon=";",Period=".",Comma=",",Slash="/",BackSlash="\\"}
local ch = sm[kn] or (#kn==1 and kn:lower()) or ""
if ch == S.prefix then showGUI(); G.cmdBar.Text = ""; wait(0.05); G.cmdBar:CaptureFocus(); return end
end
if G.cmdBar:IsFocused() then
if G.acFrame.Visible and #G.acItems > 0 then
if input.KeyCode == Enum.KeyCode.Up then
G.acSelectedIdx = G.acSelectedIdx - 1
if G.acSelectedIdx < 1 then G.acSelectedIdx = #G.acItems end
updateACSelection()
if G.acSelectedIdx >= 1 and G.acSelectedIdx <= #G.acPlayers then setPreviewHighlight(G.acPlayers[G.acSelectedIdx]) end
elseif input.KeyCode == Enum.KeyCode.Down then
G.acSelectedIdx = G.acSelectedIdx + 1
if G.acSelectedIdx > #G.acItems then G.acSelectedIdx = 1 end
updateACSelection()
if G.acSelectedIdx >= 1 and G.acSelectedIdx <= #G.acPlayers then setPreviewHighlight(G.acPlayers[G.acSelectedIdx]) end
elseif input.KeyCode == Enum.KeyCode.Tab then
G.acSelectedIdx = G.acSelectedIdx + 1
if G.acSelectedIdx > #G.acItems then G.acSelectedIdx = 1 end
updateACSelection()
if G.acSelectedIdx >= 1 and G.acSelectedIdx <= #G.acPlayers then
local plr = G.acPlayers[G.acSelectedIdx]
G.cmdBar.Text = G.acCurrentCmd .. " " .. plr.Name
setPreviewHighlight(plr)
end
elseif input.KeyCode == Enum.KeyCode.Escape then
clearAC()
clearPreviewHighlight()
end
end
end
end)

M.Players.PlayerAdded:Connect(function(plr)
G.playerCountLabel.Text = #M.Players:GetPlayers() .. " players"
if S.showPlayerCount then updatePlayerCountColor(); showFlash(isFriend(plr)); playPlayerJoinSound() end
if S.ESPenabled then
makeESP(plr)
playerAddedConns[plr.Name] = plr.CharacterAdded:Connect(function()
task.wait(0.3)
if S.ESPenabled then task.wait(0.3); if S.ESPenabled then makeESP(plr) end end
end)
end
end)

M.Players.PlayerRemoving:Connect(function(plr)
G.playerCountLabel.Text = (#M.Players:GetPlayers() - 1) .. " players"
