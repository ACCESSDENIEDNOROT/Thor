local function predictPosition(targetRoot, overrideTime)
if not targetRoot or not targetRoot.Parent then return nil, nil end
local vel = targetRoot.Velocity
local velMag = vel.Magnitude
local t = overrideTime or PredictS.baseTime
local targetCF = targetRoot.CFrame
if velMag < 0.5 then return targetRoot.Position, targetCF, 0 end
if PredictS.velocityScale then
local velBonus = math.clamp(velMag / PredictS.velFactor, 0, 2.0)
t = t * (1 + velBonus)
end
local myChar = M.lp.Character
local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso") or myChar:FindFirstChild("UpperTorso"))
local dist = 0
if myRoot then dist = (targetRoot.Position - myRoot.Position).Magnitude end
if PredictS.distanceScale and dist > 20 then
local distBonus = math.clamp((dist - 20) / 90, 0, 1.6)
t = t * (1 + distBonus)
end
t = t * PredictS.userMultiplier
t = math.min(t, PredictS.maxTime)
local predicted = targetRoot.Position + vel * t
if PredictS.gravityComp and vel.Y < 0 then
local gravityDrop = 0.5 * workspace.Gravity * t * t
predicted = predicted + Vector3.new(0, -math.min(gravityDrop * 0.45, 9), 0)
end
return predicted, targetCF, dist
end

