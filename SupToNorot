pad.PaddingLeft = UDim.new(0,6)
pad.Parent = btn
local label = plr.Name
if plr.DisplayName ~= plr.Name then label = plr.Name .. "  ·  " .. plr.DisplayName end
btn.Text = label
btn.MouseEnter:Connect(function() G.acSelectedIdx = i; updateACSelection() end)
btn.MouseButton1Click:Connect(function()
G.cmdBar.Text = cmd .. " " .. plr.Name
clearAC()
task.spawn(function() G.cmdBar:CaptureFocus() end)
end)
table.insert(G.acItems, btn)
table.insert(G.acPlayers, plr)
end
G.acSelectedIdx = 1
updateACSelection()
G.acFrame.Visible = true
end

