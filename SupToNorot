local Spring = {}
Spring.__index = Spring
function Spring.new(freq, pos) local self = setmetatable({}, Spring); self.f = freq; self.p = pos; self.v = pos * 0; return self end
function Spring:Update(dt, goal)
local f = self.f * 2 * math.pi
local offset = goal - self.p
local decay = math.exp(-f * dt)
local p1 = goal + (self.v * dt - offset * (f * dt + 1)) * decay
local v1 = (f * dt * (offset * f - self.v) + self.v) * decay
self.p = p1; self.v = v1
return p1
end
function Spring:Reset(pos) self.p = pos; self.v = pos * 0 end
local velSpring = Spring.new(5, Vector3.new())
local panSpring = Spring.new(5, Vector2.new())

