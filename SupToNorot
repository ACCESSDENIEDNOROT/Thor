local function updateAllNpcEsp()
if not S.npcEspEnabled then clearNpcEsp() return end
local allNpcs = getCachedNpcs()
local cam = workspace.CurrentCamera
if not cam then return end
local validNpcs = {}
for _, entry in pairs(allNpcs) do
local npc = entry.model
validNpcs[npc] = true
if entry.hum and entry.hum.Health > 0 and not npcEspBoxes[npc] then createNpcEsp(npc) end
end
for npc, data in pairs(npcEspBoxes) do
if not validNpcs[npc] or not npc or not npc.Parent then
if data.sg and data.sg.Parent then data.sg:Destroy() end
npcEspBoxes[npc] = nil
else
local npcHum = npc:FindFirstChildWhichIsA("Humanoid", true)
local npcRoot = npc:FindFirstChild("HumanoidRootPart", true) or npc:FindFirstChild("Torso", true) or npc:FindFirstChild("UpperTorso", true)
if npcHum and npcRoot and npcHum.Health > 0 then
local headPos = npcRoot.Position + Vector3.new(0, 2.8, 0)
local feetPos = npcRoot.Position - Vector3.new(0, 3.2, 0)
local hSc, hVis = cam:WorldToViewportPoint(headPos)
local fSc, fVis = cam:WorldToViewportPoint(feetPos)
if hVis and fVis and hSc.Z > 0 and fSc.Z > 0 then
data.box.Visible = true; data.hpBarBg.Visible = true
local screenH = math.abs(hSc.Y - fSc.Y)
local screenW = screenH * 0.55
local distance = (cam.CFrame.Position - npcRoot.Position).Magnitude
if distance > 50 then
local farScale = math.max(0.3, 1 - (distance - 50) / 300)
screenH = screenH * farScale; screenW = screenW * farScale
end
screenH = math.max(screenH, 10); screenW = math.max(screenW, 6)
data.nameText.Visible = distance > 13; data.distText.Visible = distance > 13
local cx = hSc.X; local topY = math.min(hSc.Y, fSc.Y)
local leftX = cx - screenW * 0.5; local rightX = cx + screenW * 0.5
local barW = math.max(2, math.floor(screenW * 0.08))
data.box.Position = UDim2.new(0, leftX, 0, topY)
data.box.Size = UDim2.new(0, screenW, 0, screenH)
data.hpBarBg.Position = UDim2.new(0, rightX + 2, 0, topY)
data.hpBarBg.Size = UDim2.new(0, barW, 0, screenH)
