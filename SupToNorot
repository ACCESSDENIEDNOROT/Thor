local NAV_SPEED = Vector3.new(1,1,1)
local PAN_SPEED = Vector2.new(1,1) * (math.pi/64)
local NAV_ADJ = 0.75
local NAV_SHIFT = 0.25
local navSpeed = 1
function FCInput.Vel(dt)
navSpeed = math.clamp(navSpeed + dt*(keyboard.Up-keyboard.Down)*NAV_ADJ, 0.01, 4)
local k = Vector3.new(keyboard.D-keyboard.A, keyboard.E-keyboard.Q, keyboard.S-keyboard.W) * NAV_SPEED
return k * (navSpeed * (M.UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and NAV_SHIFT or 1))
end
function FCInput.Pan(dt)
