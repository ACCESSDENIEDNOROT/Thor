while true do
if G.playerCountLabel and G.playerCountLabel.Parent then G.playerCountLabel.Text = #M.Players:GetPlayers() .. " players" end
if S.showPlayerCount then updatePlayerCountColor() end
task.wait(1)
end
end)

local function onCharacterDied()
if FlyS.flying then stopFly() end
if SafeFlyS.active then stopSafeFly() end
if AuraS.active then stopAura() end
if S.walkflingActive then stopWalkfling() end
end

local function setupDeathListener()
local char = M.lp.Character
if not char then return end
local hum = char:FindFirstChildOfClass("Humanoid")
if hum then hum.Died:Connect(onCharacterDied) end
end

M.lp.CharacterAdded:Connect(function(char)
task.wait(0.5)
setupDeathListener()
if WS.active then task.wait(0.1); wsApply() end
end)
setupDeathListener()
startNpcEspLoop()

if _G.CmdConfigs then
task.spawn(function()
task.wait(1)
for _, cmd in ipairs(_G.CmdConfigs) do
pcall(function() execCmd(cmd) end)
task.wait(0.1)
end
end)
end

end
