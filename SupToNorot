local function showAC(cmd, query)
clearAC()
G.acCurrentCmd = cmd
local q = (query or ""):lower()
local matches = {}
for _, plr in pairs(M.Players:GetPlayers()) do
if plr == M.lp and (cmd == "view" or cmd == "spectate") then continue end
if plr.Name:lower():find(q, 1, true) or plr.DisplayName:lower():find(q, 1, true) then table.insert(matches, plr) end
end
table.sort(matches, function(a,b)
local aDisplay = a.DisplayName:lower()
local bDisplay = b.DisplayName:lower()
if aDisplay ~= bDisplay then return aDisplay < bDisplay end
return a.Name:lower() < b.Name:lower()
end)
if #matches == 0 then return end
local shown = math.min(#matches, G.AC_MAX_ITEMS)
local itemH = 22
G.acFrame.Size = UDim2.new(1,0,0,shown*itemH + (shown-1)*2 + 4)
for i = 1, shown do
local plr = matches[i]
local btn = Instance.new("TextButton")
