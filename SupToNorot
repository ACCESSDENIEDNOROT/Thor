local function switchPage(pageNum)
if pageNum == G.currentPage then return end
G.btnSection.Visible = (pageNum == 1)
G.page2Frame.Visible = (pageNum == 2)
G.page3Frame.Visible = (pageNum == 3)
for i, btn in pairs(G.pageButtons) do
if i == pageNum then btn.BackgroundColor3 = C.ACTIVE; btn.TextColor3 = Color3.new(1,1,1)
else btn.BackgroundColor3 = C.BTN; btn.TextColor3 = C.SUBTEXT end
end
G.currentPage = pageNum
end

for pageNum, btn in pairs(G.pageButtons) do
btn.MouseButton1Click:Connect(function() switchPage(pageNum) end)
end
switchPage(1)

