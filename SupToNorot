local function getHint(text)
local t = text:lower():gsub("^%s+","")
if t:sub(1, #S.prefix) == S.prefix then t = t:sub(#S.prefix + 1) end
if t == "" then return "" end
for _, e in ipairs(cmdHints) do
local m = t:match(e.p)
if m ~= nil then return e.h(m) end
end
return "Type a command... (press ? for help)"
end

local function execCmd(raw)
local str = raw:lower():gsub("^%s+",""):gsub("%s+$","")
if str == "" then return end
local parts = str:split(" ")
local cmd, arg1 = parts[1], parts[2]
if cmd == "esp" then
if arg1 then
if arg1 == "all" then
if S.ESPenabled then disableESPAll(); updateBtn("esp", false); notifSet("esp", "ESP OFF", false)
else enableESPAll(); updateBtn("esp", true); notifSet("esp", "ESP ON", true) end
elseif arg1 == "others" then
for _, plr in pairs(M.Players:GetPlayers()) do if plr ~= M.lp and not soloESPPlayers[plr.Name] then makeESPSolo(plr) end end
elseif arg1 == "friends" then
for _, plr in pairs(M.Players:GetPlayers()) do if plr ~= M.lp and isFriend(plr) and not soloESPPlayers[plr.Name] then makeESPSolo(plr) end end
elseif arg1 == "bacons" or arg1 == "bacon" then
for _, plr in pairs(M.Players:GetPlayers()) do if plr ~= M.lp and isBacon(plr) and not soloESPPlayers[plr.Name] then makeESPSolo(plr) end end
else
local t = findPlayer(arg1)
if t then if soloESPPlayers[t.Name] then clearESPSolo(t) else makeESPSolo(t) end end
end
else
if S.ESPenabled then disableESPAll(); updateBtn("esp", false); notifSet("esp", "ESP OFF", false)
else enableESPAll(); updateBtn("esp", true); notifSet("esp", "ESP ON", true) end
end
elseif cmd == "toggleesp" then if arg1 then setToggleESPKey(arg1) else setToggleESPKey(nil) end
elseif cmd == "togglefc" or cmd == "togglefreecam" then if arg1 then setToggleFCKey(arg1) else setToggleFCKey(nil) end
elseif cmd == "togglefly" then if arg1 then setToggleFlyKey(arg1) else setToggleFlyKey(nil) end
