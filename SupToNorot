local hpSize = math.clamp(math.floor(screenH * 0.1), 6, 14)
data.hpText.TextSize = hpSize
data.hpText.Size = UDim2.new(0, math.max(screenW - 4, 20), 0, hpSize + 2)
data.hpText.Position = UDim2.new(1, -2, 1, -2)
local hp = math.clamp(npcHum.Health, 0, npcHum.MaxHealth)
local mx = math.max(npcHum.MaxHealth, 1)
local pct = hp / mx
data.hpFill.Size = UDim2.new(1, 0, pct, 0)
data.hpFill.Position = UDim2.new(0, 0, 1 - pct, 0)
data.hpFill.BackgroundColor3 = Color3.new(math.clamp(2*(1-pct), 0, 1), math.clamp(2*pct, 0, 1), 0)
data.hpText.Text = math.floor(pct*100) .. "%"
data.distText.Text = tostring(math.floor(distance))
else data.box.Visible = false; data.hpBarBg.Visible = false end
else data.box.Visible = false; data.hpBarBg.Visible = false end
end
end
end

