local partName = AuraS.aimPart
if partName == "Head" then
local head = npc:FindFirstChild("Head", true)
if head and head:IsA("BasePart") then return head end
local torso = npc:FindFirstChild("Torso", true) or npc:FindFirstChild("UpperTorso", true)
if torso and torso:IsA("BasePart") then return torso end
return nil
elseif partName == "Torso" then
local torso = npc:FindFirstChild("Torso", true) or npc:FindFirstChild("UpperTorso", true)
if torso and torso:IsA("BasePart") then return torso end
return nil
elseif partName == "Arms" then
local leftArm = npc:FindFirstChild("Left Arm", true) or npc:FindFirstChild("LeftHand", true)
local rightArm = npc:FindFirstChild("Right Arm", true) or npc:FindFirstChild("RightHand", true)
if leftArm and leftArm:IsA("BasePart") then return leftArm end
if rightArm and rightArm:IsA("BasePart") then return rightArm end
local torso = npc:FindFirstChild("Torso", true) or npc:FindFirstChild("UpperTorso", true)
if torso and torso:IsA("BasePart") then return torso end
return nil
elseif partName == "Legs" then
local leftLeg = npc:FindFirstChild("Left Leg", true) or npc:FindFirstChild("LeftFoot", true)
local rightLeg = npc:FindFirstChild("Right Leg", true) or npc:FindFirstChild("RightFoot", true)
if leftLeg and leftLeg:IsA("BasePart") then return leftLeg end
if rightLeg and rightLeg:IsA("BasePart") then return rightLeg end
local torso = npc:FindFirstChild("Torso", true) or npc:FindFirstChild("UpperTorso", true)
if torso and torso:IsA("BasePart") then return torso end
return nil
end
return nil
end

local function scanNpcs()
refreshMeleeEvents()
local found = {}
for _, path in ipairs(NPC_PATHS) do
local folders = findFolders(workspace, path, 1)
for _, folder in ipairs(folders) do collectNpcsRecursive(folder, found) end
end
if next(found) == nil then
for _, child in ipairs(workspace:GetChildren()) do
if child:IsA("Model") and child ~= M.lp.Character then
if child:FindFirstChildWhichIsA("Humanoid") and child:FindFirstChild("HumanoidRootPart") then found[child] = true end
end
end
end
local list = {}
for model, _ in pairs(found) do
local h = model:FindFirstChildWhichIsA("Humanoid", true)
if h and h.Health > 0 then
local root = model:FindFirstChild("HumanoidRootPart", true) or model:FindFirstChild("Torso", true) or model:FindFirstChild("UpperTorso", true)
local part = getAuraTargetPart(model) or root
table.insert(list, { model = model, hum = h, root = root, part = part })
end
end
npcCache.list = list
npcCache.lastScan = os.clock()
npcCache.aimPartCached = AuraS.aimPart
end

local function getCachedNpcs(force)
local needRescan = force or (os.clock() - npcCache.lastScan >= NPC_SCAN_COOLDOWN) or (npcCache.aimPartCached ~= AuraS.aimPart)
if needRescan then scanNpcs() end
return npcCache.list
end

